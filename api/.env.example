# Copy to .env and fill in. Generate a secret with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Journal photos (originals, display copies, thumbnails). Fly: /data/photos.
PHOTO_DIR=./data/photos
# Trip documents (tickets, passport scans). Fly: /data/documents.
DOCUMENT_DIR=./data/documents
CORS_ORIGINS=http://localhost:3000

# Port the dev API binds to (api/dev.sh). Worktrees get their own — see
# scripts/new-worktree.sh.
API_PORT=8000

# Seed credentials (dev only — change for anything shared)
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=changeme-user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin
# A second traveler, joined to the sample trip as a viewer (sharing).
SEED_VIEWER_EMAIL=pripri@example.com
SEED_VIEWER_PASSWORD=changeme-viewer

# Google Maps/Places browser key for place search (served to signed-in users by
# GET /config). Restrict it in the Google console to your sites
# (http://localhost:3000/*) and to Maps JavaScript API + Places API (New).
GOOGLE_MAPS_API_KEY=

# Map ID for the map view's Advanced Markers (Google Cloud Console -> Maps
# Management -> Create Map ID, JavaScript type). Not secret.
GOOGLE_MAPS_MAP_ID=

# OpenWeatherMap key for the trip weather page (server-side only, never sent to
# the browser). Needs the "One Call by Call" subscription (One Call 3.0); set a
# daily call limit of 1,000 in OpenWeatherMap's dashboard so it stays free.
# Optional: without it the weather page says weather isn't set up.
# Fly: fly secrets set OPENWEATHER_API_KEY=...
OPENWEATHER_API_KEY=

# Umami usage analytics: the instance's address and this site's website id,
# handed to the browser by GET /config. Not secret. Leave empty to send
# nothing (the default, so local testing doesn't count). Who is counted is
# a per-person switch on the Admin page.
# Fly: fly secrets set UMAMI_URL=https://... UMAMI_WEBSITE_ID=...
UMAMI_URL=
UMAMI_WEBSITE_ID=
