# Copy this file to .env and fill in your values

# Password used to authenticate against the API
APP_PASSWORD=honeymoon

# Secret used to sign/verify bearer tokens (change this in production!)
TOKEN_SECRET=dev-secret-change-me

# Google Maps API key returned to the frontend after auth
MAPS_API_KEY=

# PostgreSQL connection URL.
# For local dev with docker-compose the service name 'db' is the host.
# For production replace with your managed PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pripritrip
