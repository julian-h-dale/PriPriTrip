# Copy this file to .env and fill in your values

# PostgreSQL connection URL.
# For local dev with docker-compose the host is localhost (container publishes 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pripritrip

# Secret used to sign/verify JWT bearer tokens (change this in production!)
JWT_SECRET=dev-secret-change-me

# Google Maps API key returned to the frontend after auth (Places autocomplete, maps)
MAPS_API_KEY=

# OpenAI — required for AI chat and document import features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2

# Chat assistant dispatch: "loop" = tool-calling loop (default),
# "batch" = legacy one-shot structured-output workflows (kill switch)
CHAT_ASSISTANT_MODE=loop

# Logging
APP_LOG_LEVEL=INFO
AI_LOG_PATH=ai.log
AI_LOG_LEVEL=INFO
AI_LOG_MAX_BYTES=10485760
AI_LOG_BACKUP_COUNT=3
