### PriPriTrip API
### Base URL: http://localhost:8000
### Requires the REST Client extension (humao.rest-client)

@baseUrl = http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication
# Run this request first, copy the token from the response, and paste it
# into the @token variable below.
# ---------------------------------------------------------------------------

### POST /auth — obtain a bearer token
POST {{baseUrl}}/auth
Content-Type: application/json

{
  "password": "honeymoon"
}

# After running the request above, set the token here:
@token = <paste-token-here>

# ---------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------

### GET /health — liveness check (no auth required)
GET {{baseUrl}}/health

# ---------------------------------------------------------------------------
# Trip header
# ---------------------------------------------------------------------------

### GET /trip — fetch the full trip (header + all active items)
GET {{baseUrl}}/trip
Authorization: Bearer {{token}}

### POST /trip — create or update the trip header
POST {{baseUrl}}/trip
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tripId": "trip-001",
  "tripName": "Honeymoon 2025",
  "startDate": "2025-08-01",
  "endDate": "2025-08-14"
}

# ---------------------------------------------------------------------------
# Trip items — list
# ---------------------------------------------------------------------------

### GET /trip/items — list all active (non-deleted) items
GET {{baseUrl}}/trip/items
Authorization: Bearer {{token}}

### GET /trip/items/deleted — list soft-deleted items
GET {{baseUrl}}/trip/items/deleted
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Trip items — create
# ---------------------------------------------------------------------------

### POST /trip/items — create a group item
POST {{baseUrl}}/trip/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "group-001",
  "tripId": "trip-001",
  "parentItemId": null,
  "kind": "group",
  "title": "Arrival in Paris",
  "startDateTime": "2025-08-01T14:00:00Z",
  "endDateTime": "2025-08-01T20:00:00Z",
  "sortOrder": 1,
  "locations": [
    { "name": "Charles de Gaulle Airport", "lat": 49.0097, "lng": 2.5479 }
  ]
}

### POST /trip/items — create a leg item inside a group
POST {{baseUrl}}/trip/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "leg-001",
  "tripId": "trip-001",
  "parentItemId": "group-001",
  "kind": "leg",
  "title": "Flight CDG → JFK",
  "type": "flight",
  "subtype": "economy",
  "startDateTime": "2025-08-14T10:00:00Z",
  "endDateTime": "2025-08-14T13:30:00Z",
  "sortOrder": 2,
  "confirmationNumber": "AF001",
  "description": "Air France direct flight",
  "locations": [
    { "name": "Charles de Gaulle Airport", "lat": 49.0097, "lng": 2.5479 },
    { "name": "JFK International Airport", "lat": 40.6413, "lng": -73.7781 }
  ]
}

# ---------------------------------------------------------------------------
# Trip items — full replace
# ---------------------------------------------------------------------------

### PUT /trip/items/:id — fully replace an item
@itemId = leg-001

PUT {{baseUrl}}/trip/items/{{itemId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "leg-001",
  "tripId": "trip-001",
  "parentItemId": "group-001",
  "kind": "leg",
  "title": "Flight CDG → JFK (updated)",
  "type": "flight",
  "subtype": "business",
  "startDateTime": "2025-08-14T11:00:00Z",
  "endDateTime": "2025-08-14T14:30:00Z",
  "sortOrder": 2,
  "confirmationNumber": "AF002",
  "description": "Upgraded to business class",
  "locations": [
    { "name": "Charles de Gaulle Airport", "lat": 49.0097, "lng": 2.5479 },
    { "name": "JFK International Airport", "lat": 40.6413, "lng": -73.7781 }
  ]
}

# ---------------------------------------------------------------------------
# Trip items — partial update
# ---------------------------------------------------------------------------

### PATCH /trip/items/:id — update only the supplied fields
PATCH {{baseUrl}}/trip/items/{{itemId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Flight CDG → JFK (patched title)",
  "completed": true,
  "completedDateTime": "2025-08-14T14:35:00Z"
}

# ---------------------------------------------------------------------------
# Trip items — soft delete & restore
# ---------------------------------------------------------------------------

### DELETE /trip/items/:id — soft-delete an item (sets deletedAt, returns 204)
DELETE {{baseUrl}}/trip/items/{{itemId}}
Authorization: Bearer {{token}}

### POST /trip/items/:id/restore — restore a soft-deleted item
POST {{baseUrl}}/trip/items/{{itemId}}/restore
Authorization: Bearer {{token}}
