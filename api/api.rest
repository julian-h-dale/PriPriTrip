# ---------------------------------------------------------------------------
# Trip header
# ---------------------------------------------------------------------------

### GET /trip — fetch the full assembled trip (header + all days + points)
GET {{baseUrl}}/trip
Authorization: Bearer {{token}}

### POST /trip — create or update the trip header fields only
POST {{baseUrl}}/trip
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tripId": "honeymoon-2026",
  "tripName": "Switzerland & Croatia Honeymoon",
  "startDate": "2026-05-10",
  "endDate": "2026-05-20"
}

# ---------------------------------------------------------------------------
# Trip days — list
# ---------------------------------------------------------------------------

### GET /trip/days — list all active (non-deleted) days
GET {{baseUrl}}/trip/days
Authorization: Bearer {{token}}

### GET /trip/days/deleted — list soft-deleted days
GET {{baseUrl}}/trip/days/deleted
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Trip days — create
# ---------------------------------------------------------------------------

### POST /trip/days — create a day
POST {{baseUrl}}/trip/days
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "dayId": "day-2026-05-11",
  "title": "May 11 — Arrival in Bern",
  "date": "2026-05-11",
  "description": "Arrive Zurich Airport, train to Bern.",
  "sortOrder": 1,
  "isAlternate": false,
  "completed": false
}

# ---------------------------------------------------------------------------
# Trip days — update
# ---------------------------------------------------------------------------

@dayId = day-2026-05-11

### PUT /trip/days/:id — fully replace a day (all fields required)
PUT {{baseUrl}}/trip/days/{{dayId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "May 11 — Arrival in Bern (updated)",
  "date": "2026-05-11",
  "description": "Updated description.",
  "sortOrder": 1,
  "isAlternate": false,
  "completed": false
}

### PATCH /trip/days/:id — update only the supplied fields
PATCH {{baseUrl}}/trip/days/{{dayId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "completed": true
}

### DELETE /trip/days/:id — soft-delete a day (sets deletedAt, returns 204)
DELETE {{baseUrl}}/trip/days/{{dayId}}
Authorization: Bearer {{token}}

### POST /trip/days/:id/restore — restore a soft-deleted day
POST {{baseUrl}}/trip/days/{{dayId}}/restore
Authorization: Bearer {{token}}

