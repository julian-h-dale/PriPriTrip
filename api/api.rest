### PriPriTrip API
### Base URL: http://localhost:8000
### Requires the REST Client extension (humao.rest-client)

@baseUrl = http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication
# Run the session request first, copy the token from the response, and paste
# it into the @token variable below.
# ---------------------------------------------------------------------------

### POST /auth/session — obtain a bearer token
POST {{baseUrl}}/auth/session
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "your-password"
}

# After running the request above, set the token here:
@token = <paste-token-here>
@tripId = 00000000-0000-0000-0000-000000000001
@dayId = 00000000-0000-0000-0000-000000000002
@pointId = 00000000-0000-0000-0000-000000000003
@documentId = 00000000-0000-0000-0000-000000000004

# ---------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------

### GET /health — liveness check (no auth required)
GET {{baseUrl}}/health

# ---------------------------------------------------------------------------
# Trips
# ---------------------------------------------------------------------------

### GET /trips — list trips
GET {{baseUrl}}/trips
Authorization: Bearer {{token}}

### GET /trips/:tripId — fetch the full assembled trip
GET {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

### PUT /trips/:tripId — create or update the trip header (returns the header)
PUT {{baseUrl}}/trips/{{tripId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tripName": "Switzerland & Croatia Honeymoon",
  "startDate": "2026-05-10",
  "endDate": "2026-05-20"
}

### GET /trips/:tripId/verify — deterministic trip verification
GET {{baseUrl}}/trips/{{tripId}}/verify
Authorization: Bearer {{token}}

### DELETE /trips/:tripId — soft-delete a trip and its children
DELETE {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Import (bulk full replace)
# ---------------------------------------------------------------------------

### POST /trips/:tripId/import — replace all trip data from the trip contract
POST {{baseUrl}}/trips/{{tripId}}/import
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tripName": "Switzerland & Croatia Honeymoon",
  "startDate": "2026-05-10",
  "endDate": "2026-05-20",
  "stays": [],
  "travels": [],
  "days": []
}

# ---------------------------------------------------------------------------
# AI import / enhance
# ---------------------------------------------------------------------------

### POST /trips/ai-import — structure a document into a NEW draft trip (multipart)
# POST {{baseUrl}}/trips/ai-import   (multipart form: file)

### POST /trips/:tripId/ai-import — structure an itinerary for an existing trip
# POST {{baseUrl}}/trips/{{tripId}}/ai-import   (multipart form: file)

### POST /trips/ai-enhance — enrich a draft trip's descriptions
POST {{baseUrl}}/trips/ai-enhance
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tripName": "Trip",
  "startDate": "2026-05-10",
  "endDate": "2026-05-20",
  "stays": [],
  "travels": [],
  "days": []
}

# ---------------------------------------------------------------------------
# AI documents
# ---------------------------------------------------------------------------

### POST /trips/:tripId/ai-documents — extract records from a document (multipart)
# POST {{baseUrl}}/trips/{{tripId}}/ai-documents  (multipart form: file, workflowMode)

### GET /trips/:tripId/ai-documents — list a trip's AI documents
GET {{baseUrl}}/trips/{{tripId}}/ai-documents
Authorization: Bearer {{token}}

### GET /ai-documents/:documentId — re-read a stored extraction
GET {{baseUrl}}/ai-documents/{{documentId}}
Authorization: Bearer {{token}}

### POST /ai-documents/:documentId/regen — re-run extraction on the stored text
POST {{baseUrl}}/ai-documents/{{documentId}}/regen
Authorization: Bearer {{token}}

### POST /ai-documents/:documentId/save — persist selected extracted records
POST {{baseUrl}}/ai-documents/{{documentId}}/save
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "stayDetailIds": [],
  "travelDetailIds": []
}

# ---------------------------------------------------------------------------
# Trip days
# ---------------------------------------------------------------------------

### GET /trips/:tripId/days — list active days
GET {{baseUrl}}/trips/{{tripId}}/days
Authorization: Bearer {{token}}

### GET /trips/:tripId/days/deleted — list soft-deleted days
GET {{baseUrl}}/trips/{{tripId}}/days/deleted
Authorization: Bearer {{token}}

### POST /trips/:tripId/days — create a day
POST {{baseUrl}}/trips/{{tripId}}/days
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "dayId": "{{dayId}}",
  "title": "May 11 — Arrival in Bern",
  "date": "2026-05-11",
  "description": "Arrive Zurich Airport, train to Bern.",
  "isAlternate": false,
  "completed": false
}

### PATCH /trips/:tripId/days/:dayId — update only the supplied fields
PATCH {{baseUrl}}/trips/{{tripId}}/days/{{dayId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "completed": true
}

### DELETE /trips/:tripId/days/:dayId — soft-delete a day (204)
DELETE {{baseUrl}}/trips/{{tripId}}/days/{{dayId}}
Authorization: Bearer {{token}}

### POST /trips/:tripId/days/:dayId/restore — restore a soft-deleted day
POST {{baseUrl}}/trips/{{tripId}}/days/{{dayId}}/restore
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Trip points
# ---------------------------------------------------------------------------

### GET /trips/:tripId/points — list active points
GET {{baseUrl}}/trips/{{tripId}}/points
Authorization: Bearer {{token}}

### GET /trips/:tripId/points/deleted — list soft-deleted points
GET {{baseUrl}}/trips/{{tripId}}/points/deleted
Authorization: Bearer {{token}}

### POST /trips/:tripId/points — create a point
POST {{baseUrl}}/trips/{{tripId}}/points
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pointId": "{{pointId}}",
  "dayId": "{{dayId}}",
  "type": "activity",
  "title": "Lunch in Bern",
  "startDateTime": "2026-05-11T14:15:00",
  "endDateTime": "2026-05-11T15:15:00",
  "locations": [
    {
      "role": "venue",
      "name": "Kornhauskeller",
      "lat": 46.948730,
      "lng": 7.447269
    }
  ]
}

### PATCH /trips/:tripId/points/:pointId — update only the supplied fields
PATCH {{baseUrl}}/trips/{{tripId}}/points/{{pointId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "completed": true,
  "completedDateTime": "2026-05-11T13:30:00"
}

### DELETE /trips/:tripId/points/:pointId — soft-delete a point (204)
DELETE {{baseUrl}}/trips/{{tripId}}/points/{{pointId}}
Authorization: Bearer {{token}}

### POST /trips/:tripId/points/:pointId/restore — restore a soft-deleted point
POST {{baseUrl}}/trips/{{tripId}}/points/{{pointId}}/restore
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Travel / stay details
# ---------------------------------------------------------------------------

### GET /trips/:tripId/travel-details
GET {{baseUrl}}/trips/{{tripId}}/travel-details
Authorization: Bearer {{token}}

### GET /trips/:tripId/stay-details
GET {{baseUrl}}/trips/{{tripId}}/stay-details
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Chat
# ---------------------------------------------------------------------------

### POST /chat/reply
POST {{baseUrl}}/chat/reply
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "workflowName": "trip:new_trip",
  "message": "Help me plan a trip to Bern"
}

### GET /chat/trips/:tripId?workflowName=trip:new_trip
GET {{baseUrl}}/chat/trips/{{tripId}}?workflowName=trip:new_trip
Authorization: Bearer {{token}}

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------

### GET /profile
GET {{baseUrl}}/profile
Authorization: Bearer {{token}}

### POST /profile/timezone — timezone lookup by coordinates
POST {{baseUrl}}/profile/timezone
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lat": 46.948730,
  "lng": 7.447269
}
