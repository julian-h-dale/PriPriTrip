# /etc/pripri-backup.env — read by pripri-backup.service. Keep it root-only
# (install.sh makes it mode 600): it holds the backup account's password.
API_URL=https://pripri-trip.fly.dev/api
# A superuser account used only by the Pi (see scripts/pi-backup/README.md).
BACKUP_EMAIL=
BACKUP_PASSWORD=
# The backup drive's mount point.
BACKUP_DIR=/mnt/pripri-backup
