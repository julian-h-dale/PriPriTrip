{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trip Import Model",
  "description": "Canonical trip model used by POST /trip/import. Travel and stay details are first-class objects at trip level; day points reference them by ID.",
  "type": "object",
  "required": ["tripName", "startDate", "endDate", "stays", "travels", "days"],
  "properties": {
    "tripId": {
      "type": "string",
      "description": "Unique identifier for the trip (UUID). Optional on import; generated if omitted."
    },
    "tripName": {
      "type": "string",
      "description": "Human-readable name of the trip."
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "Trip start date, ISO 8601 (YYYY-MM-DD)."
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "description": "Trip end date, ISO 8601 (YYYY-MM-DD)."
    },
    "stays": {
      "type": "array",
      "description": "First-class stay details. Points reference stays through stayDetailId.",
      "items": { "$ref": "#/$defs/stayDetail" },
      "default": []
    },
    "travels": {
      "type": "array",
      "description": "First-class travel details. Points reference travels through travelDetailId.",
      "items": { "$ref": "#/$defs/travelDetail" },
      "default": []
    },
    "days": {
      "type": "array",
      "description": "Ordered list of trip days.",
      "items": { "$ref": "#/$defs/day" },
      "default": []
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "required": ["title", "date", "points"],
      "properties": {
        "dayId": {
          "type": "string",
          "description": "Unique identifier for the day (UUID). Optional on import; generated if omitted."
        },
        "title": {
          "type": "string",
          "description": "Short day title."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Day date, ISO 8601 (YYYY-MM-DD)."
        },
        "description": {
          "type": ["string", "null"],
          "description": "Narrative day summary."
        },
        "isAlternate": {
          "type": "boolean",
          "default": false,
          "description": "True if this day is an alternate/optional plan."
        },
        "completed": {
          "type": "boolean",
          "default": false
        },
        "points": {
          "type": "array",
          "description": "Ordered list of points within the day.",
          "items": { "$ref": "#/$defs/point" },
          "default": []
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "pointId": {
          "type": "string",
          "description": "Unique identifier for the point (UUID). Optional on import; generated if omitted."
        },
        "dayId": {
          "type": ["string", "null"],
          "description": "Optional in import payloads; inferred from containing day when omitted."
        },
        "type": {
          "type": "string",
          "enum": ["check-in", "check-out", "departure", "arrival", "activity"],
          "description": "Action-focused point type."
        },
        "title": { "type": "string" },
        "stayDetailId": {
          "type": ["string", "null"],
          "description": "Reference to a stay in top-level stays[]."
        },
        "travelDetailId": {
          "type": ["string", "null"],
          "description": "Reference to a travel in top-level travels[]."
        },
        "startDateTime": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "endDateTime": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "confirmationNumber": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "imageUrl": { "type": ["string", "null"] },
        "logoUrl": { "type": ["string", "null"] },
        "locations": {
          "type": "array",
          "description": "Point-owned locations. Use when location is specific to this point.",
          "items": { "$ref": "#/$defs/location" },
          "default": []
        },
        "completed": { "type": "boolean", "default": false },
        "completedDateTime": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "check-in" } }, "required": ["type"] },
          "then": { "required": ["stayDetailId"] }
        },
        {
          "if": { "properties": { "type": { "const": "check-out" } }, "required": ["type"] },
          "then": { "required": ["stayDetailId"] }
        },
        {
          "if": { "properties": { "type": { "const": "arrival" } }, "required": ["type"] },
          "then": { "required": ["travelDetailId"] }
        },
        {
          "if": { "properties": { "type": { "const": "departure" } }, "required": ["type"] },
          "then": { "required": ["travelDetailId"] }
        }
      ]
    },
    "location": {
      "type": "object",
      "required": ["role", "name"],
      "properties": {
        "locationId": {
          "type": "string",
          "description": "Unique identifier for the location (UUID). Optional on import; generated if omitted."
        },
        "role": {
          "type": "string",
          "enum": ["origin", "destination", "venue", "waypoint"]
        },
        "name": { "type": "string" },
        "lat": { "type": ["number", "null"] },
        "lng": { "type": ["number", "null"] },
        "fullAddress": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "link": { "type": ["string", "null"] },
        "googlePlaceId": { "type": ["string", "null"] },
        "googleMapsUri": { "type": ["string", "null"] }
      }
    },
    "travelDetail": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "travelDetailId": {
          "type": "string",
          "description": "Unique identifier for this first-class travel detail (UUID). Optional on import; generated if omitted."
        },
        "name": { "type": ["string", "null"] },
        "mode": {
          "type": "string",
          "enum": ["flight", "train", "car", "bus", "ferry", "boat", "walk", "hike", "other"]
        },
        "operator": { "type": ["string", "null"] },
        "vehicleNumber": { "type": ["string", "null"] },
        "cabinClass": { "type": ["string", "null"] },
        "departureDateTime": { "type": ["string", "null"], "format": "date-time" },
        "arrivalDateTime": { "type": ["string", "null"], "format": "date-time" },
        "confirmationNumber": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "locations": {
          "type": "array",
          "description": "Travel-owned locations (for example origin and destination airports/stations).",
          "items": { "$ref": "#/$defs/location" },
          "default": []
        }
      }
    },
    "stayDetail": {
      "type": "object",
      "required": ["stayType"],
      "properties": {
        "stayDetailId": {
          "type": "string",
          "description": "Unique identifier for this first-class stay detail (UUID). Optional on import; generated if omitted."
        },
        "name": { "type": ["string", "null"] },
        "stayType": {
          "type": "string",
          "enum": ["hotel", "hostel", "airbnb", "rental", "other"]
        },
        "checkIn": { "type": ["string", "null"], "format": "date-time" },
        "checkOut": { "type": ["string", "null"], "format": "date-time" },
        "roomType": { "type": ["string", "null"] },
        "confirmationNumber": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "locations": {
          "type": "array",
          "description": "Stay-owned locations (usually hotel/accommodation venue).",
          "items": { "$ref": "#/$defs/location" },
          "default": []
        }
      }
    }
  }
}
