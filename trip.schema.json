{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trip Import Model",
  "description": "Canonical trip model used by the PriPriTrip API import endpoint (POST /trip/import). A trip contains ordered days; each day contains ordered points (travel/stay/activity); points contain locations and optional travel/stay details.",
  "type": "object",
  "required": ["tripId", "tripName", "startDate", "endDate", "days"],
  "properties": {
    "tripId": {
      "type": "string",
      "description": "Unique identifier for the trip (UUID)."
    },
    "tripName": {
      "type": "string",
      "description": "Human-readable name of the trip."
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "Trip start date, ISO 8601 (YYYY-MM-DD)."
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "description": "Trip end date, ISO 8601 (YYYY-MM-DD)."
    },
    "days": {
      "type": "array",
      "description": "Ordered list of trip days.",
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "required": ["dayId", "title", "date"],
      "properties": {
        "dayId": { "type": "string", "description": "Unique identifier for the day (UUID)." },
        "title": { "type": "string", "description": "Short day title, e.g. 'May 11 — Arrival in Bern'." },
        "date": { "type": "string", "format": "date", "description": "Day date, ISO 8601 (YYYY-MM-DD)." },
        "description": {
          "type": ["string", "null"],
          "description": "Narrative day summary. The AI enhance pass expands this into an exciting overview of the day's highlights."
        },
        "isAlternate": { "type": "boolean", "default": false, "description": "True if this day is an alternate/optional plan." },
        "completed": { "type": "boolean", "default": false },
        "points": {
          "type": "array",
          "description": "Ordered list of points within the day.",
          "items": { "$ref": "#/$defs/point" },
          "default": []
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["pointId", "dayId", "type", "title"],
      "properties": {
        "pointId": { "type": "string", "description": "Unique identifier for the point (UUID)." },
        "dayId": { "type": "string", "description": "The dayId this point belongs to." },
        "type": {
          "type": "string",
          "enum": ["travel", "stay", "activity"],
          "description": "The kind of point."
        },
        "title": { "type": "string" },
        "startDateTime": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 datetime with timezone offset, e.g. 2026-05-11T12:15:00+02:00."
        },
        "endDateTime": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "confirmationNumber": { "type": ["string", "null"] },
        "description": {
          "type": ["string", "null"],
          "description": "Concise, helpful description of the point. Kept shorter than day descriptions."
        },
        "imageUrl": { "type": ["string", "null"] },
        "logoUrl": { "type": ["string", "null"] },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" },
          "default": []
        },
        "travelDetail": {
          "oneOf": [{ "$ref": "#/$defs/travelDetail" }, { "type": "null" }],
          "description": "Present only for type=travel."
        },
        "stayDetail": {
          "oneOf": [{ "$ref": "#/$defs/stayDetail" }, { "type": "null" }],
          "description": "Present only for type=stay."
        },
        "completed": { "type": "boolean", "default": false },
        "completedDateTime": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "location": {
      "type": "object",
      "required": ["locationId", "role", "name"],
      "properties": {
        "locationId": { "type": "string", "description": "Unique identifier for the location (UUID)." },
        "role": {
          "type": "string",
          "enum": ["origin", "destination", "venue", "waypoint"],
          "description": "Role of the location within the point. travel points use origin/destination/waypoint; stay/activity points use venue."
        },
        "name": { "type": "string" },
        "lat": { "type": ["number", "null"], "description": "Filled by Google Places enrichment; leave null on AI output." },
        "lng": { "type": ["number", "null"], "description": "Filled by Google Places enrichment; leave null on AI output." },
        "fullAddress": { "type": ["string", "null"], "description": "Filled/normalised by Google Places enrichment." },
        "description": { "type": ["string", "null"], "description": "Short description of the location." },
        "link": { "type": ["string", "null"] },
        "googlePlaceId": { "type": ["string", "null"], "description": "Filled by Google Places enrichment; leave null on AI output." },
        "googleMapsUri": { "type": ["string", "null"], "description": "Filled by Google Places enrichment; leave null on AI output." }
      }
    },
    "travelDetail": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["flight", "train", "car", "bus", "ferry", "boat", "walk", "hike", "other"]
        },
        "operator": { "type": ["string", "null"] },
        "vehicleNumber": { "type": ["string", "null"] },
        "cabinClass": { "type": ["string", "null"] }
      }
    },
    "stayDetail": {
      "type": "object",
      "required": ["stayType"],
      "properties": {
        "stayType": {
          "type": "string",
          "enum": ["hotel", "hostel", "airbnb", "rental", "other"]
        },
        "checkInTime": { "type": ["string", "null"] },
        "checkOutTime": { "type": ["string", "null"] },
        "roomType": { "type": ["string", "null"] }
      }
    }
  }
}
